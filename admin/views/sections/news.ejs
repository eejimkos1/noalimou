<div class="editor__header">
  <a href="/admin" class="editor__back">&larr;</a>
  <span class="editor__icon"><%= sectionMeta.icon %></span>
  <h1 class="editor__title"><%= sectionMeta.label %></h1>
</div>

<form method="POST" action="/admin/news" id="sectionForm">
  <input type="hidden" name="_json" id="jsonData">

  <div class="form">
    <h3 style="margin-bottom:1rem;">Επικεφαλίδα</h3>
    <div class="form__group">
      <label class="form__label">Ετικέτα ενότητας</label>
      <input class="form__input" type="text" data-field="sectionLabel" value="<%= section.sectionLabel %>">
    </div>
    <div class="form__group">
      <label class="form__label">Τίτλος</label>
      <input class="form__input" type="text" data-field="title" value="<%= section.title %>">
    </div>
    <div class="form__row">
      <div class="form__group">
        <label class="form__label">Κουμπί «Όλα τα Νέα» — κείμενο</label>
        <input class="form__input" type="text" data-field="allNewsLabel" value="<%= section.allNewsLabel %>">
      </div>
      <div class="form__group">
        <label class="form__label">Κουμπί «Όλα τα Νέα» — URL</label>
        <input class="form__input" type="text" data-field="allNewsUrl" value="<%= section.allNewsUrl %>">
      </div>
    </div>
  </div>

  <div class="form">
    <h3 style="margin-bottom:1rem;">Άρθρα / Νέα</h3>
    <div class="form__array" id="cardsArray">
      <% section.cards.forEach(function(card, i) { %>
        <div class="form__array-item" data-index="<%= i %>">
          <div class="form__array-header" onclick="toggleArrayItem(this)">
            <span class="form__array-header-title"><%= card.date %> — <%= card.title.substring(0, 40) %>...</span>
            <div class="form__array-header-actions">
              <button type="button" class="form__array-btn" onclick="event.stopPropagation(); moveArrayItem(this, -1)" title="Πάνω">↑</button>
              <button type="button" class="form__array-btn" onclick="event.stopPropagation(); moveArrayItem(this, 1)" title="Κάτω">↓</button>
              <button type="button" class="form__array-btn form__array-btn--delete" onclick="event.stopPropagation(); removeArrayItem(this)" title="Διαγραφή">🗑</button>
              <span class="form__array-toggle" style="cursor:pointer;">▼</span>
            </div>
          </div>
          <div class="form__array-body">
            <div class="form__group">
              <label class="form__label">Εικόνα URL</label>
              <div class="form__image-wrap">
                <div class="form__image-preview" id="preview_card_<%= i %>_image">
                  <% if (card.imageUrl) { %><img src="<%= card.imageUrl %>" alt="Preview"><% } else { %>Χωρίς εικόνα<% } %>
                </div>
                <div class="form__image-inputs">
                  <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="imageUrl" value="<%= card.imageUrl %>" onchange="updateImagePreview('card_<%= i %>_image', this.value)">
                  <label class="form__upload-btn">
                    📁 Ανέβασμα
                    <input type="file" class="form__upload-input" accept="image/*" onchange="uploadImageToField(this, null, 'card_<%= i %>_image')">
                  </label>
                </div>
              </div>
            </div>
            <div class="form__group">
              <label class="form__label">Alt εικόνας</label>
              <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="imageAlt" value="<%= card.imageAlt %>">
            </div>
            <div class="form__group">
              <label class="form__label">Ημερομηνία</label>
              <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="date" value="<%= card.date %>" placeholder="π.χ. 6 Οκτωβρίου 2025">
            </div>
            <div class="form__group">
              <label class="form__label">Τίτλος</label>
              <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="title" value="<%= card.title %>">
            </div>
            <div class="form__group">
              <label class="form__label">Περίληψη</label>
              <textarea class="form__textarea" data-array="cards" data-index="<%= i %>" data-key="excerpt" rows="3"><%= card.excerpt %></textarea>
            </div>
            <div class="form__row">
              <div class="form__group">
                <label class="form__label">URL συνδέσμου</label>
                <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="linkUrl" value="<%= card.linkUrl %>">
              </div>
              <div class="form__group">
                <label class="form__label">Κείμενο συνδέσμου</label>
                <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="linkText" value="<%= card.linkText %>">
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <button type="button" class="form__add-btn" onclick="addNews()">+ Προσθήκη Άρθρου</button>
  </div>

  <div class="form__actions">
    <button type="submit" class="form__save-btn">Αποθήκευση</button>
    <a href="/admin/preview" target="_blank" class="form__preview-btn">Προεπισκόπηση</a>
  </div>
</form>
