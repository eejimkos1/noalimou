<div class="editor__header">
  <a href="/admin" class="editor__back">&larr;</a>
  <span class="editor__icon"><%= sectionMeta.icon %></span>
  <h1 class="editor__title"><%= sectionMeta.label %></h1>
</div>

<form method="POST" action="/admin/footer" id="sectionForm">
  <input type="hidden" name="_json" id="jsonData">

  <div class="form">
    <h3 style="margin-bottom:1rem;">Brand</h3>
    <div class="form__group">
      <label class="form__label">Όνομα (σύντομο)</label>
      <input class="form__input" type="text" data-field="brandName" value="<%= section.brandName %>">
    </div>
    <div class="form__group">
      <label class="form__label">Περιγραφή</label>
      <textarea class="form__textarea" data-field="brandDesc" rows="3"><%= section.brandDesc %></textarea>
    </div>
  </div>

  <div class="form">
    <h3 style="margin-bottom:1rem;">Social Links</h3>
    <div class="form__array" id="socialLinksArray">
      <% section.socialLinks.forEach(function(link, i) { %>
        <div class="form__array-item" data-index="<%= i %>">
          <div class="form__array-header" onclick="toggleArrayItem(this)">
            <span class="form__array-header-title"><%= link.platform %></span>
            <div class="form__array-header-actions">
              <button type="button" class="form__array-btn form__array-btn--delete" onclick="event.stopPropagation(); removeArrayItem(this)" title="Διαγραφή">🗑</button>
              <span class="form__array-toggle" style="cursor:pointer;">▼</span>
            </div>
          </div>
          <div class="form__array-body">
            <div class="form__row">
              <div class="form__group">
                <label class="form__label">Platform</label>
                <select class="form__select" data-array="socialLinks" data-index="<%= i %>" data-key="platform">
                  <option value="facebook" <%= link.platform === 'facebook' ? 'selected' : '' %>>Facebook</option>
                  <option value="instagram" <%= link.platform === 'instagram' ? 'selected' : '' %>>Instagram</option>
                  <option value="youtube" <%= link.platform === 'youtube' ? 'selected' : '' %>>YouTube</option>
                </select>
              </div>
              <div class="form__group">
                <label class="form__label">URL</label>
                <input class="form__input" type="text" data-array="socialLinks" data-index="<%= i %>" data-key="url" value="<%= link.url %>">
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <button type="button" class="form__add-btn" onclick="addSocialLink()">+ Προσθήκη Social</button>
  </div>

  <div class="form">
    <h3 style="margin-bottom:1rem;">Σύνδεσμοι</h3>
    <h4 style="margin-bottom:0.75rem;">Γρήγοροι Σύνδεσμοι</h4>
    <div class="form__array" id="quickLinksArray">
      <% section.quickLinks.forEach(function(link, i) { %>
        <div class="form__array-item" data-index="<%= i %>">
          <div class="form__array-header" onclick="toggleArrayItem(this)">
            <span class="form__array-header-title"><%= link.label %></span>
            <div class="form__array-header-actions">
              <button type="button" class="form__array-btn form__array-btn--delete" onclick="event.stopPropagation(); removeArrayItem(this)" title="Διαγραφή">🗑</button>
              <span class="form__array-toggle" style="cursor:pointer;">▼</span>
            </div>
          </div>
          <div class="form__array-body">
            <div class="form__row">
              <div class="form__group">
                <label class="form__label">Κείμενο</label>
                <input class="form__input" type="text" data-array="quickLinks" data-index="<%= i %>" data-key="label" value="<%= link.label %>">
              </div>
              <div class="form__group">
                <label class="form__label">Link</label>
                <input class="form__input" type="text" data-array="quickLinks" data-index="<%= i %>" data-key="href" value="<%= link.href %>">
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <button type="button" class="form__add-btn" onclick="addQuickLink()">+ Σύνδεσμος</button>

    <h4 style="margin:1.5rem 0 0.75rem;">Αθλήματα (Footer)</h4>
    <div class="form__array" id="sportLinksArray">
      <% section.sportLinks.forEach(function(link, i) { %>
        <div class="form__array-item" data-index="<%= i %>">
          <div class="form__array-header" onclick="toggleArrayItem(this)">
            <span class="form__array-header-title"><%= link.label %></span>
            <div class="form__array-header-actions">
              <button type="button" class="form__array-btn form__array-btn--delete" onclick="event.stopPropagation(); removeArrayItem(this)" title="Διαγραφή">🗑</button>
              <span class="form__array-toggle" style="cursor:pointer;">▼</span>
            </div>
          </div>
          <div class="form__array-body">
            <div class="form__row">
              <div class="form__group">
                <label class="form__label">Κείμενο</label>
                <input class="form__input" type="text" data-array="sportLinks" data-index="<%= i %>" data-key="label" value="<%= link.label %>">
              </div>
              <div class="form__group">
                <label class="form__label">Link</label>
                <input class="form__input" type="text" data-array="sportLinks" data-index="<%= i %>" data-key="href" value="<%= link.href %>">
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <button type="button" class="form__add-btn" onclick="addSportLink()">+ Άθλημα Link</button>
  </div>

  <div class="form">
    <h3 style="margin-bottom:1rem;">Επικοινωνία</h3>
    <div class="form__group">
      <label class="form__label">Διεύθυνση</label>
      <div class="form__hint">Χρησιμοποιήστε Enter για αλλαγή γραμμής</div>
      <textarea class="form__textarea" data-nested="contact" data-key="address" rows="3"><%= section.contact.address %></textarea>
    </div>
    <div class="form__row">
      <div class="form__group">
        <label class="form__label">Τηλέφωνο (εμφάνιση)</label>
        <input class="form__input" type="text" data-nested="contact" data-key="phone" value="<%= section.contact.phone %>">
      </div>
      <div class="form__group">
        <label class="form__label">Τηλέφωνο (href)</label>
        <input class="form__input" type="text" data-nested="contact" data-key="phoneHref" value="<%= section.contact.phoneHref %>">
      </div>
    </div>
    <div class="form__group">
      <label class="form__label">Email</label>
      <input class="form__input" type="text" data-nested="contact" data-key="email" value="<%= section.contact.email %>">
    </div>
  </div>

  <div class="form">
    <h3 style="margin-bottom:1rem;">Newsletter</h3>
    <div class="form__row" style="grid-template-columns:1fr 80px 1fr;">
      <div class="form__group">
        <label class="form__label">Placeholder</label>
        <input class="form__input" type="text" data-nested="newsletter" data-key="placeholder" value="<%= section.newsletter.placeholder %>">
      </div>
      <div class="form__group">
        <label class="form__label">Κουμπί</label>
        <input class="form__input" type="text" data-nested="newsletter" data-key="buttonText" value="<%= section.newsletter.buttonText %>">
      </div>
      <div class="form__group">
        <label class="form__label">Μήνυμα επιτυχίας</label>
        <input class="form__input" type="text" data-nested="newsletter" data-key="successMessage" value="<%= section.newsletter.successMessage %>">
      </div>
    </div>
  </div>

  <div class="form">
    <h3 style="margin-bottom:1rem;">Χάρτης & Κάτω μέρος</h3>
    <div class="form__group">
      <label class="form__label">Google Maps Embed URL</label>
      <div class="form__hint">Αντιγράψτε το src= URL από το Google Maps embed code</div>
      <input class="form__input" type="text" data-field="mapEmbedUrl" value="<%= section.mapEmbedUrl %>">
    </div>
    <div class="form__group">
      <label class="form__label">Copyright</label>
      <input class="form__input" type="text" data-field="copyrightText" value="<%= section.copyrightText %>">
    </div>
    <div class="form__group">
      <label class="form__label">Μητρώο / Πληροφορίες</label>
      <input class="form__input" type="text" data-field="registryText" value="<%= section.registryText %>">
    </div>
  </div>

  <div class="form__actions">
    <button type="submit" class="form__save-btn">Αποθήκευση</button>
    <a href="/admin/preview" target="_blank" class="form__preview-btn">Προεπισκόπηση</a>
  </div>
</form>
