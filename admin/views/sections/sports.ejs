<div class="editor__header">
  <a href="/admin" class="editor__back">&larr;</a>
  <span class="editor__icon"><%= sectionMeta.icon %></span>
  <h1 class="editor__title"><%= sectionMeta.label %></h1>
</div>

<form method="POST" action="/admin/sports" id="sectionForm">
  <input type="hidden" name="_json" id="jsonData">

  <div class="form">
    <h3 style="margin-bottom:1rem;">Επικεφαλίδα</h3>
    <div class="form__group">
      <label class="form__label">Ετικέτα ενότητας</label>
      <input class="form__input" type="text" data-field="sectionLabel" value="<%= section.sectionLabel %>">
    </div>
    <div class="form__group">
      <label class="form__label">Τίτλος</label>
      <div class="form__hint">Χρήση &lt;br&gt; για αλλαγή γραμμής</div>
      <input class="form__input" type="text" data-field="title" value="<%= section.title %>">
    </div>
    <div class="form__group">
      <label class="form__label">Υπότιτλος</label>
      <textarea class="form__textarea" data-field="subtitle" rows="2"><%= section.subtitle %></textarea>
    </div>
  </div>

  <div class="form">
    <h3 style="margin-bottom:1rem;">Κάρτες Αθλημάτων</h3>
    <div class="form__array" id="cardsArray">
      <% section.cards.forEach(function(card, i) { %>
        <div class="form__array-item" data-index="<%= i %>">
          <div class="form__array-header" onclick="toggleArrayItem(this)">
            <span class="form__array-header-title"><%= card.icon %> <%= card.name %></span>
            <div class="form__array-header-actions">
              <button type="button" class="form__array-btn" onclick="event.stopPropagation(); moveArrayItem(this, -1)" title="Πάνω">↑</button>
              <button type="button" class="form__array-btn" onclick="event.stopPropagation(); moveArrayItem(this, 1)" title="Κάτω">↓</button>
              <button type="button" class="form__array-btn form__array-btn--delete" onclick="event.stopPropagation(); removeArrayItem(this)" title="Διαγραφή">🗑</button>
              <span class="form__array-toggle" style="cursor:pointer;">▼</span>
            </div>
          </div>
          <div class="form__array-body">
            <div class="form__row">
              <div class="form__group">
                <label class="form__label">Όνομα αθλήματος</label>
                <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="name" value="<%= card.name %>">
              </div>
              <div class="form__group">
                <label class="form__label">Εικονίδιο (emoji)</label>
                <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="icon" value="<%= card.icon %>" style="font-size:1.5rem;">
              </div>
            </div>
            <div class="form__group">
              <label class="form__label">Περιγραφή</label>
              <textarea class="form__textarea" data-array="cards" data-index="<%= i %>" data-key="description" rows="2"><%= card.description %></textarea>
            </div>
            <div class="form__group">
              <label class="form__label">Εικόνα</label>
              <div class="form__image-wrap">
                <div class="form__image-preview" id="preview_sport_<%= i %>">
                  <% if (card.imageUrl) { %><img src="<%= card.imageUrl %>" alt="Preview"><% } else { %>Χωρίς εικόνα<% } %>
                </div>
                <div class="form__image-inputs">
                  <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="imageUrl" value="<%= card.imageUrl %>" onchange="updateImagePreview('sport_<%= i %>', this.value)">
                  <label class="form__upload-btn">
                    📁 Ανέβασμα
                    <input type="file" class="form__upload-input" accept="image/*" onchange="uploadImageToField(this, null, 'sport_<%= i %>')">
                  </label>
                </div>
              </div>
            </div>
            <div class="form__row">
              <div class="form__group">
                <label class="form__label">Alt εικόνας</label>
                <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="imageAlt" value="<%= card.imageAlt %>">
              </div>
              <div class="form__group">
                <label class="form__label">Κείμενο συνδέσμου</label>
                <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="linkText" value="<%= card.linkText %>">
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <button type="button" class="form__add-btn" onclick="addSportCard()">+ Προσθήκη Αθλήματος</button>
  </div>

  <div class="form">
    <h3 style="margin-bottom:1rem;">Quiz — Ποιο άθλημα σου ταιριάζει;</h3>
    <div class="form__group">
      <label class="form__label">Τίτλος quiz</label>
      <input class="form__input" type="text" data-object="quiz" data-key="title" value="<%= section.quiz.title %>">
    </div>
    <div class="form__group">
      <label class="form__label">Υπότιτλος quiz</label>
      <input class="form__input" type="text" data-object="quiz" data-key="subtitle" value="<%= section.quiz.subtitle %>">
    </div>
    <div class="form__array" id="quizOptionsArray">
      <% section.quiz.options.forEach(function(opt, i) { %>
        <div class="form__array-item" data-index="<%= i %>">
          <div class="form__array-header" onclick="toggleArrayItem(this)">
            <span class="form__array-header-title"><%= opt.label %> → <%= opt.key %></span>
            <div class="form__array-header-actions">
              <button type="button" class="form__array-btn form__array-btn--delete" onclick="event.stopPropagation(); removeArrayItem(this)" title="Διαγραφή">🗑</button>
              <span class="form__array-toggle" style="cursor:pointer;">▼</span>
            </div>
          </div>
          <div class="form__array-body">
            <div class="form__row" style="grid-template-columns:120px 120px 1fr;">
              <div class="form__group">
                <label class="form__label">Ετικέτα</label>
                <input class="form__input" type="text" data-object="quiz" data-objarray="options" data-index="<%= i %>" data-key="label" value="<%= opt.label %>">
              </div>
              <div class="form__group">
                <label class="form__label">Key</label>
                <input class="form__input" type="text" data-object="quiz" data-objarray="options" data-index="<%= i %>" data-key="key" value="<%= opt.key %>">
              </div>
              <div class="form__group">
                <label class="form__label">Αποτέλεσμα</label>
                <input class="form__input" type="text" data-object="quiz" data-objarray="options" data-index="<%= i %>" data-key="result" value="<%= opt.result %>">
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <button type="button" class="form__add-btn" onclick="addQuizOption()">+ Προσθήκη Επιλογής</button>
  </div>

  <div class="form__actions">
    <button type="submit" class="form__save-btn">Αποθήκευση</button>
    <a href="/admin/preview" target="_blank" class="form__preview-btn">Προεπισκόπηση</a>
  </div>
</form>
