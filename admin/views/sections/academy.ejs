<div class="editor__header">
  <a href="/admin" class="editor__back">&larr;</a>
  <span class="editor__icon"><%= sectionMeta.icon %></span>
  <h1 class="editor__title"><%= sectionMeta.label %></h1>
</div>

<form method="POST" action="/admin/academy" id="sectionForm">
  <input type="hidden" name="_json" id="jsonData">

  <div class="form">
    <h3 style="margin-bottom:1rem;">Επικεφαλίδα</h3>
    <div class="form__group">
      <label class="form__label">Ετικέτα ενότητας</label>
      <input class="form__input" type="text" data-field="sectionLabel" value="<%= section.sectionLabel %>">
    </div>
    <div class="form__group">
      <label class="form__label">Τίτλος</label>
      <div class="form__hint">Χρήση &lt;br&gt; για αλλαγή γραμμής</div>
      <input class="form__input" type="text" data-field="title" value="<%= section.title %>">
    </div>
    <div class="form__group">
      <label class="form__label">Υπότιτλος</label>
      <textarea class="form__textarea" data-field="subtitle" rows="3"><%= section.subtitle %></textarea>
    </div>
  </div>

  <div class="form">
    <h3 style="margin-bottom:1rem;">Εικόνα & CTA</h3>
    <div class="form__group">
      <label class="form__label">Εικόνα</label>
      <div class="form__image-wrap">
        <div class="form__image-preview" id="preview_academyImg">
          <% if (section.imageUrl) { %><img src="<%= section.imageUrl %>" alt="Preview"><% } else { %>Χωρίς εικόνα<% } %>
        </div>
        <div class="form__image-inputs">
          <input class="form__input" type="text" data-field="imageUrl" value="<%= section.imageUrl %>" onchange="updateImagePreview('academyImg', this.value)">
          <label class="form__upload-btn">
            📁 Ανέβασμα
            <input type="file" class="form__upload-input" accept="image/*" onchange="uploadImageToField(this, 'imageUrl', 'academyImg')">
          </label>
        </div>
      </div>
    </div>
    <div class="form__group">
      <label class="form__label">Alt εικόνας</label>
      <input class="form__input" type="text" data-field="imageAlt" value="<%= section.imageAlt %>">
    </div>
    <div class="form__row">
      <div class="form__group">
        <label class="form__label">Κείμενο CTA</label>
        <input class="form__input" type="text" data-field="ctaLabel" value="<%= section.ctaLabel %>">
      </div>
      <div class="form__group">
        <label class="form__label">URL CTA</label>
        <input class="form__input" type="text" data-field="ctaHref" value="<%= section.ctaHref %>">
      </div>
    </div>
  </div>

  <div class="form">
    <h3 style="margin-bottom:1rem;">Βήματα Ακαδημίας</h3>
    <div class="form__array" id="stepsArray">
      <% section.steps.forEach(function(step, i) { %>
        <div class="form__array-item" data-index="<%= i %>">
          <div class="form__array-header" onclick="toggleArrayItem(this)">
            <span class="form__array-header-title">Βήμα <%= step.number %>: <%= step.title %></span>
            <div class="form__array-header-actions">
              <button type="button" class="form__array-btn" onclick="event.stopPropagation(); moveArrayItem(this, -1)" title="Πάνω">↑</button>
              <button type="button" class="form__array-btn" onclick="event.stopPropagation(); moveArrayItem(this, 1)" title="Κάτω">↓</button>
              <button type="button" class="form__array-btn form__array-btn--delete" onclick="event.stopPropagation(); removeArrayItem(this)" title="Διαγραφή">🗑</button>
              <span class="form__array-toggle" style="cursor:pointer;">▼</span>
            </div>
          </div>
          <div class="form__array-body">
            <div class="form__row" style="grid-template-columns:60px 1fr 120px;">
              <div class="form__group">
                <label class="form__label">Αριθμός</label>
                <input class="form__input" type="text" data-array="steps" data-index="<%= i %>" data-key="number" value="<%= step.number %>">
              </div>
              <div class="form__group">
                <label class="form__label">Τίτλος</label>
                <input class="form__input" type="text" data-array="steps" data-index="<%= i %>" data-key="title" value="<%= step.title %>">
              </div>
              <div class="form__group">
                <label class="form__label">Badge class</label>
                <select class="form__select" data-array="steps" data-index="<%= i %>" data-key="badgeClass">
                  <option value="beginner" <%= step.badgeClass === 'beginner' ? 'selected' : '' %>>Αρχάριοι</option>
                  <option value="intermediate" <%= step.badgeClass === 'intermediate' ? 'selected' : '' %>>Μέσοι</option>
                  <option value="advanced" <%= step.badgeClass === 'advanced' ? 'selected' : '' %>>Προχωρημένοι</option>
                </select>
              </div>
            </div>
            <div class="form__group">
              <label class="form__label">Badge κείμενο</label>
              <input class="form__input" type="text" data-array="steps" data-index="<%= i %>" data-key="badgeText" value="<%= step.badgeText %>">
            </div>
            <div class="form__group">
              <label class="form__label">Κείμενο</label>
              <textarea class="form__textarea" data-array="steps" data-index="<%= i %>" data-key="text" rows="2"><%= step.text %></textarea>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <button type="button" class="form__add-btn" onclick="addAcademyStep()">+ Προσθήκη Βήματος</button>
  </div>

  <div class="form__actions">
    <button type="submit" class="form__save-btn">Αποθήκευση</button>
    <a href="/admin/preview" target="_blank" class="form__preview-btn">Προεπισκόπηση</a>
  </div>
</form>
