<div class="editor__header">
  <a href="/admin" class="editor__back">&larr;</a>
  <span class="editor__icon"><%= sectionMeta.icon %></span>
  <h1 class="editor__title"><%= sectionMeta.label %></h1>
</div>

<form method="POST" action="/admin/membership" id="sectionForm">
  <input type="hidden" name="_json" id="jsonData">

  <div class="form">
    <h3 style="margin-bottom:1rem;">Επικεφαλίδα</h3>
    <div class="form__group">
      <label class="form__label">Ετικέτα ενότητας</label>
      <input class="form__input" type="text" data-field="sectionLabel" value="<%= section.sectionLabel %>">
    </div>
    <div class="form__group">
      <label class="form__label">Τίτλος</label>
      <div class="form__hint">Χρήση &lt;br&gt; για αλλαγή γραμμής</div>
      <input class="form__input" type="text" data-field="title" value="<%= section.title %>">
    </div>
    <div class="form__group">
      <label class="form__label">Υπότιτλος</label>
      <textarea class="form__textarea" data-field="subtitle" rows="2"><%= section.subtitle %></textarea>
    </div>
  </div>

  <div class="form">
    <h3 style="margin-bottom:1rem;">Πακέτα Εγγραφής</h3>
    <div class="form__array" id="tiersArray">
      <% section.tiers.forEach(function(tier, i) { %>
        <div class="form__array-item" data-index="<%= i %>">
          <div class="form__array-header" onclick="toggleArrayItem(this)">
            <span class="form__array-header-title"><%= tier.icon %> <%= tier.title %><%= tier.featured ? ' ⭐' : '' %></span>
            <div class="form__array-header-actions">
              <button type="button" class="form__array-btn" onclick="event.stopPropagation(); moveArrayItem(this, -1)" title="Πάνω">↑</button>
              <button type="button" class="form__array-btn" onclick="event.stopPropagation(); moveArrayItem(this, 1)" title="Κάτω">↓</button>
              <button type="button" class="form__array-btn form__array-btn--delete" onclick="event.stopPropagation(); removeArrayItem(this)" title="Διαγραφή">🗑</button>
              <span class="form__array-toggle" style="cursor:pointer;">▼</span>
            </div>
          </div>
          <div class="form__array-body">
            <div class="form__row" style="grid-template-columns:80px 1fr auto;">
              <div class="form__group">
                <label class="form__label">Εικονίδιο</label>
                <input class="form__input" type="text" data-array="tiers" data-index="<%= i %>" data-key="icon" value="<%= tier.icon %>" style="font-size:1.5rem; text-align:center;">
              </div>
              <div class="form__group">
                <label class="form__label">Τίτλος</label>
                <input class="form__input" type="text" data-array="tiers" data-index="<%= i %>" data-key="title" value="<%= tier.title %>">
              </div>
              <div class="form__group">
                <label class="form__label">Προβεβλημένο</label>
                <select class="form__select" data-array="tiers" data-index="<%= i %>" data-key="featured">
                  <option value="false" <%= !tier.featured ? 'selected' : '' %>>Όχι</option>
                  <option value="true" <%= tier.featured ? 'selected' : '' %>>Ναι</option>
                </select>
              </div>
            </div>
            <div class="form__group">
              <label class="form__label">Περιγραφή</label>
              <textarea class="form__textarea" data-array="tiers" data-index="<%= i %>" data-key="description" rows="2"><%= tier.description %></textarea>
            </div>
            <div class="form__group">
              <label class="form__label">Χαρακτηριστικά (ένα ανά γραμμή)</label>
              <textarea class="form__textarea" data-array="tiers" data-index="<%= i %>" data-key="featuresText" rows="4"><%= tier.features.join('\n') %></textarea>
              <div class="form__hint">Γράψτε κάθε χαρακτηριστικό σε νέα γραμμή</div>
            </div>
            <div class="form__row" style="grid-template-columns:1fr 1fr auto;">
              <div class="form__group">
                <label class="form__label">Κείμενο CTA</label>
                <input class="form__input" type="text" data-array="tiers" data-index="<%= i %>" data-key="ctaLabel" value="<%= tier.ctaLabel %>">
              </div>
              <div class="form__group">
                <label class="form__label">URL CTA</label>
                <input class="form__input" type="text" data-array="tiers" data-index="<%= i %>" data-key="ctaHref" value="<%= tier.ctaHref %>">
              </div>
              <div class="form__group">
                <label class="form__label">Στυλ</label>
                <select class="form__select" data-array="tiers" data-index="<%= i %>" data-key="ctaStyle">
                  <option value="primary" <%= tier.ctaStyle === 'primary' ? 'selected' : '' %>>Primary</option>
                  <option value="gold" <%= tier.ctaStyle === 'gold' ? 'selected' : '' %>>Gold</option>
                </select>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="form__actions">
    <button type="submit" class="form__save-btn">Αποθήκευση</button>
    <a href="/admin/preview" target="_blank" class="form__preview-btn">Προεπισκόπηση</a>
  </div>
</form>
