<div class="editor__header">
  <a href="/admin" class="editor__back">&larr;</a>
  <span class="editor__icon"><%= sectionMeta.icon %></span>
  <h1 class="editor__title"><%= sectionMeta.label %></h1>
</div>

<form method="POST" action="/admin/events" id="sectionForm">
  <input type="hidden" name="_json" id="jsonData">

  <div class="form">
    <h3 style="margin-bottom:1rem;">Επικεφαλίδα</h3>
    <div class="form__group">
      <label class="form__label">Ετικέτα ενότητας</label>
      <input class="form__input" type="text" data-field="sectionLabel" value="<%= section.sectionLabel %>">
    </div>
    <div class="form__group">
      <label class="form__label">Τίτλος</label>
      <div class="form__hint">Χρήση &lt;br&gt; για αλλαγή γραμμής</div>
      <input class="form__input" type="text" data-field="title" value="<%= section.title %>">
    </div>
    <div class="form__group">
      <label class="form__label">Υπότιτλος</label>
      <textarea class="form__textarea" data-field="subtitle" rows="2"><%= section.subtitle %></textarea>
    </div>
  </div>

  <div class="form">
    <h3 style="margin-bottom:1rem;">Εκδηλώσεις / Αγώνες</h3>
    <div class="form__array" id="cardsArray">
      <% section.cards.forEach(function(card, i) { %>
        <div class="form__array-item" data-index="<%= i %>">
          <div class="form__array-header" onclick="toggleArrayItem(this)">
            <span class="form__array-header-title"><%= card.dateDay %>/<%= card.dateMonth %> — <%= card.title %></span>
            <div class="form__array-header-actions">
              <button type="button" class="form__array-btn" onclick="event.stopPropagation(); moveArrayItem(this, -1)" title="Πάνω">↑</button>
              <button type="button" class="form__array-btn" onclick="event.stopPropagation(); moveArrayItem(this, 1)" title="Κάτω">↓</button>
              <button type="button" class="form__array-btn form__array-btn--delete" onclick="event.stopPropagation(); removeArrayItem(this)" title="Διαγραφή">🗑</button>
              <span class="form__array-toggle" style="cursor:pointer;">▼</span>
            </div>
          </div>
          <div class="form__array-body">
            <div class="form__row" style="grid-template-columns:80px 80px 1fr;">
              <div class="form__group">
                <label class="form__label">Ημέρα</label>
                <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="dateDay" value="<%= card.dateDay %>" placeholder="06">
              </div>
              <div class="form__group">
                <label class="form__label">Μήνας</label>
                <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="dateMonth" value="<%= card.dateMonth %>" placeholder="Οκτ">
              </div>
              <div class="form__group">
                <label class="form__label">Κατηγορία</label>
                <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="category" value="<%= card.category %>" placeholder="π.χ. Windsurf, Ιστιοπλοΐα">
              </div>
            </div>
            <div class="form__group">
              <label class="form__label">Τίτλος εκδήλωσης</label>
              <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="title" value="<%= card.title %>">
            </div>
            <div class="form__group">
              <label class="form__label">Περιγραφή</label>
              <textarea class="form__textarea" data-array="cards" data-index="<%= i %>" data-key="description" rows="2"><%= card.description %></textarea>
            </div>
            <div class="form__row">
              <div class="form__group">
                <label class="form__label">Tag κείμενο</label>
                <input class="form__input" type="text" data-array="cards" data-index="<%= i %>" data-key="tagText" value="<%= card.tagText %>">
              </div>
              <div class="form__group">
                <label class="form__label">Tag χρώμα</label>
                <select class="form__select" data-array="cards" data-index="<%= i %>" data-key="tagClass">
                  <option value="sailing" <%= card.tagClass === 'sailing' ? 'selected' : '' %>>Ιστιοπλοΐα (μπλε)</option>
                  <option value="windsurf" <%= card.tagClass === 'windsurf' ? 'selected' : '' %>>Windsurf (πορτοκαλί)</option>
                  <option value="general" <%= card.tagClass === 'general' ? 'selected' : '' %>>Γενικό (μωβ)</option>
                </select>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <button type="button" class="form__add-btn" onclick="addEvent()">+ Προσθήκη Εκδήλωσης</button>
  </div>

  <div class="form__actions">
    <button type="submit" class="form__save-btn">Αποθήκευση</button>
    <a href="/admin/preview" target="_blank" class="form__preview-btn">Προεπισκόπηση</a>
  </div>
</form>
